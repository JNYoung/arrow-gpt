{
  "name": "arrow-again",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && npm run ga:config",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "generate:levels": "node scripts/generate-levels.mjs",
    "verify:levels": "node scripts/verify-levels.mjs",
    "verify:balance": "node scripts/verify-balance.mjs",
    "verify:platform": "node scripts/verify-platform-manifest.mjs",
    "verify:platform:release": "node scripts/verify-platform-manifest.mjs --release",
    "verify:android:release": "node scripts/verify-platform-manifest.mjs --release --target=android",
    "verify:analytics": "node scripts/verify-analytics-config.mjs",
    "growth:verify": "node scripts/verify-growth-framework.mjs",
    "ga:daily": "node scripts/run-ga-daily-monitor.mjs",
    "play:reports": "node scripts/fetch-google-play-reports.mjs",
    "verify:all": "npm run typecheck && npm run verify:levels && npm run verify:balance && npm run verify:platform && npm run e2e",
    "admob:sync": "node scripts/sync-admob-config.mjs",
    "admob:sync:test": "node scripts/sync-admob-config.mjs --test",
    "ga:config": "node scripts/write-platform-runtime-config.mjs",
    "firebase:version": "PATH=\"$HOME/.local/bin:$PATH\" firebase --version",
    "firebase:apps": "PATH=\"$HOME/.local/bin:$PATH\" firebase apps:list --project arrow-again-game",
    "firebase:config:web": "PATH=\"$HOME/.local/bin:$PATH\" firebase apps:sdkconfig WEB 1:365113945933:web:ac305eeac306487bd11104 --project arrow-again-game",
    "firebase:config:android": "PATH=\"$HOME/.local/bin:$PATH\" firebase apps:sdkconfig ANDROID 1:365113945933:android:b6b3395480c22a87d11104 --project arrow-again-game",
    "firebase:config:ios": "PATH=\"$HOME/.local/bin:$PATH\" firebase apps:sdkconfig IOS 1:365113945933:ios:3eb5bed3f8dbed1dd11104 --project arrow-again-game",
    "firebase:analytics:status": "node scripts/link-firebase-analytics.mjs --status",
    "firebase:analytics:link": "node scripts/link-firebase-analytics.mjs --write-manifest",
    "admob:config:android:test": "node scripts/write-platform-runtime-config.mjs --admob-test --native-platform android --render-quality balanced",
    "assets:release": "node scripts/generate-release-assets.mjs",
    "e2e": "npm run build && node scripts/run-e2e.mjs",
    "meta:zip": "npm run build && node scripts/package-meta.mjs",
    "meta:zip:debug": "npm run build && node scripts/package-meta.mjs --mock-rewarded",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync android && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer npx cap sync ios",
    "ios:prepare": "npm run build && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer npx cap sync ios",
    "native:prepare": "npm run assets:release && npm run cap:sync",
    "google:aab": "npm run verify:android:release && npm run build && npx cap sync android && node scripts/run-android-gradle.mjs bundleRelease",
    "android:debug": "npm run build && npx cap sync android && node scripts/run-android-gradle.mjs assembleDebug",
    "android:debug:ads": "npm run build && npm run admob:config:android:test && npx cap sync android && node scripts/run-android-gradle.mjs assembleDebug",
    "android:open": "npm run build && npx cap sync android && npx cap open android",
    "ios:open": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/share": "^7.0.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
